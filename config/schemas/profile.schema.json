{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easywin.local/schemas/profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "description", "settings", "defaultApplicationIds", "removeProvisionedAppPackages", "preserveWindowsUpdate", "preserveDefender", "preserveMicrosoftStore", "preserveRecovery", "preserveServicingStack"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "minLength": 1, "maxLength": 512 },
    "settings": { "type": "object", "additionalProperties": { "type": "string" } },
    "defaultApplicationIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "removeProvisionedAppPackages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9.]+$" },
      "uniqueItems": true
    },
    "preserveWindowsUpdate": { "const": true },
    "preserveDefender": { "const": true },
    "preserveMicrosoftStore": { "const": true },
    "preserveRecovery": { "const": true },
    "preserveServicingStack": { "const": true }
  }
}
