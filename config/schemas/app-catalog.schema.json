{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easywin.local/schemas/app-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "applications"],
  "properties": {
    "version": { "const": 2 },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "installer", "arguments", "sha256", "successExitCodes", "requiresReboot"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "requiredHardwareIdPrefixes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "installer": { "type": "string", "pattern": "^(?![A-Za-z]:|[/\\\\]|.*\\.\\.).+" },
          "arguments": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 256 } },
          "sha256": { "type": "string" },
          "sizeBytes": { "type": ["integer", "null"], "minimum": 0 },
          "successExitCodes": { "type": "array", "minItems": 1, "items": { "type": "integer" }, "uniqueItems": true },
          "requiresReboot": { "type": "boolean" }
        }
      }
    }
  }
}
