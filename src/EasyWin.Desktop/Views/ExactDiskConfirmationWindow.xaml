<Window x:Class="EasyWin.Desktop.Views.ExactDiskConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение выбранных дисков"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="22" FontWeight="SemiBold" Text="Последнее подтверждение" />
        <TextBlock Grid.Row="1" Margin="0,8,0,18" Foreground="{StaticResource MutedTextBrush}" Text="Проверьте назначение каждого диска. После перезагрузки все разделы и данные на перечисленных дисках будут удалены." />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14" Background="#261A24" BorderBrush="#643944">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding DiskDisplayName}" />
                <TextBlock Margin="0,5,0,0" FontFamily="Consolas" FontSize="12" Foreground="#FFB7BB" Text="{Binding DiskDetails}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,18,0,20">
            <TextBlock Text="Введите указанную фразу без изменений:" />
            <TextBlock Margin="0,6,0,8" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="{Binding RequiredText}" />
            <TextBox x:Name="ConfirmationTextBox"
                     Text="{Binding EnteredText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Фраза подтверждения диска" />
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" IsCancel="True" Content="Отмена" />
            <Button Grid.Column="3"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    IsEnabled="{Binding IsMatch}"
                    Click="OnConfirm"
                    Content="Подтвердить диски" />
        </Grid>
    </Grid>
</Window>
